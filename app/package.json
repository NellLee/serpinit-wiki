{
	"name": "app",
	"version": "0.0.1",
	"private": true,
	"packageManager": "yarn@1.22.19",
	"scripts": {
		"dev": "node scripts/dev-warmup.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "yarn run check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"postinstall": "cd .. && node scripts/setup-git-hooks.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.44.1",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/d3": "^7.4.3",
		"@types/eslint": "^8.56.0",
		"@types/jsdom": "^21.1.6",
		"@types/node": "^20.11.28",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"sass": "^1.77.4",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-hero-icons": "^5.1.0",
		"tslib": "^2.4.1",
		"typescript": "^5.5.0",
		"vite": "^5.4.4",
		"vite-plugin-node-polyfills": "^0.21.0",
		"vitest": "^1.6.1"
	},
	"type": "module",
	"dependencies": {
		"@fancyapps/ui": "^5.0.36",
		"ajv": "^6.12.6",
		"cheerio": "^1.0.0-rc.12",
		"d3": "^7.9.0",
		"fuse.js": "^7.0.0",
		"isomorphic-dompurify": "^2.4.0",
		"jsdom": "^24.0.0",
		"katex": "^0.16.11",
		"marked": "^12.0.1",
		"marked-directive": "^1.0.5",
		"marked-katex-extension": "^5.0.2"
	}
}
